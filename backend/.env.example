ADMIN_TOKEN=changeme

# JWT (obrigatório; gerar com: openssl rand -base64 48)
JWT_SECRET=changeme-please-rotate-and-make-it-long-enough-for-256-bits

# Cookie (dev: false; prod via SP6: true)
COOKIE_SECURE=false

# SameSite do cookie de sessão. "Lax" funciona quando front e back rodam na mesma
# origem (mesmo host:port, ou via reverse proxy). Em dev local com front:3000 +
# back:8080, defina "None" + COOKIE_SECURE=true para que o browser envie o cookie
# em POST cross-origin (browsers aceitam Secure=true em localhost mesmo sem TLS).
COOKIE_SAME_SITE=Lax

# SMTP (dev: MailHog default; prod via SP6)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_TLS=false
MAIL_FROM=no-reply@bragas.local
MAIL_RESET_BASE_URL=http://localhost:3000/redefinir-senha
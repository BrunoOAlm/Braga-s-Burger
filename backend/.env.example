# JWT (obrigatório; gerar com: openssl rand -base64 48)
JWT_SECRET=changeme-please-rotate-and-make-it-long-enough-for-256-bits

# Cookie de sessão. Os defaults aqui são para dev local cross-port (front:3000 +
# back:8080): Secure=true + SameSite=None permite que o browser envie o cookie em
# POST cross-origin (browsers aceitam Secure=true em localhost mesmo sem TLS).
# Em prod com front e back na mesma origem (ou via reverse proxy), troque para
# COOKIE_SAME_SITE=Lax (e mantenha COOKIE_SECURE=true atrás de HTTPS).
COOKIE_SECURE=true
COOKIE_SAME_SITE=None

# SMTP (dev: MailHog default; prod via SP6)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_TLS=false
MAIL_FROM=no-reply@bragas.local
MAIL_RESET_BASE_URL=http://localhost:3000/redefinir-senha

# Admin bootstrap (obrigatório no primeiro boot)
# Gerar o hash bcrypt via: ./gradlew bcryptHash -Ppassword=SUA_SENHA  (ver Task 10)
ADMIN_BOOTSTRAP_ID=adm_01HXYZ0123456789ABCDEFGH
ADMIN_BOOTSTRAP_EMAIL=admin@bragas.local
ADMIN_BOOTSTRAP_PASSWORD_HASH=$2a$10$replace_me_with_real_bcrypt_hash_60_chars
ADMIN_BOOTSTRAP_NAME=Admin